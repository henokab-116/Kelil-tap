PORT=3000

# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# true  = demo/testing: free 100 ETB welcome bonus, fake Telebirr top-up, drivers auto-approved,
#         manual code entry on the driver terminal.
# false = production: drivers must be approved with `npm run admin -- approve <phone>`,
#         top-up is disabled until a real Telebirr integration is added.
DEMO_MODE=true

# Optional limits (ETB)
MAX_FARE_ETB=100
MAX_TOPUP_ETB=5000
MIN_WITHDRAW_ETB=10
WELCOME_BONUS_ETB=100

# Set NODE_ENV=production on the server. Set TRUST_PROXY=true when behind nginx/Cloudflare.
# NODE_ENV=production
# TRUST_PROXY=true
# DB_PATH=./data/transit.db
